FLASK_APP=wsgi.py
FLASK_ENV=development
# No host -> connects over the local Unix socket with peer auth (no password needed).
# Use a full postgresql://user:pass@host:port/dbname URL instead if connecting over TCP.
DATABASE_URL=postgresql:///metoo_dev
JWT_SECRET_KEY=change-me-to-a-random-secret
FRONTEND_ORIGIN=http://localhost:5173

# Web Push (optional). Generate your own with: python generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@example.com

# Optional error tracking; leave blank to disable (pip install sentry-sdk already included)
SENTRY_DSN=
